{
  "name": "@watchtowerobservability/chrome-extension",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchtowerobservability/watchtower-chrome-extension.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Watchtower SDK for browser extensions (Chrome, Edge, Firefox, Safari; MV3): errors, breadcrumbs, lifecycle, cross-context tracing, page vitals, durable queue, shared session, manifest checks",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./integrations": "./dist/integrations.js",
    "./pages": "./dist/pages.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "prebuild": "node scripts/browser-src.mjs",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run && node --test test/"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "0.25.10",
    "vitest": "5.0.5",
    "web-vitals": "5.1.0"
  },
  "bin": {
    "wt-ext": "./bin/wt-ext.mjs"
  }
}
